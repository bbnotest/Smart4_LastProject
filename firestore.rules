rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedInSmartUser() {
      return request.auth != null
        && request.auth.token.email.matches('.*@smart[.]com$');
    }

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ["안중재@smart.com", "양윤석@smart.com"];
    }

    function isGuest() {
      return request.auth != null
        && request.auth.token.email == "기획자@smart.com";
    }

    match /scrumEntries/{document} {
      allow read: if isSignedInSmartUser();
      allow create, update, delete: if isAdmin();
    }

    match /scrumTeamNotes/{document} {
      allow read: if isSignedInSmartUser();
      allow create, update, delete: if isAdmin();
    }

    match /scrumDelayReviews/{document} {
      allow read: if isSignedInSmartUser();
      allow create, update: if isSignedInSmartUser() && !isGuest();
      allow delete: if isAdmin();
    }

    match /scrumStudentReports/{reportId} {
      allow read: if isSignedInSmartUser();
      allow create, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
